# Order and notification service local env
# Local profile loads this file first, then falls back to bidmart-infrastructure/.env when present

PORT=8084
# Production on Heroku should use Supabase Postgres values:
# DATABASE_URL=jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres.<project-ref>
# DATABASE_PASSWORD=<supabase-db-password>
DATABASE_URL=jdbc:h2:mem:orders;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Swagger UI (docker-compose)
SWAGGER_UI_PORT=8088
