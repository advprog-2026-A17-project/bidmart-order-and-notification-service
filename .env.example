# Order and notification service local env
# Local profile loads this file first, then falls back to bidmart-infrastructure/.env when present

PORT=8084
# Production on Heroku — set these in Heroku config vars (NOT here):
# Order project ref: hcsrkmlqekuhouenbusg (ap-southeast-2). Heroku dynos are IPv4-only and
# Supabase direct (db.<ref>.supabase.co) is IPv6-only, so use the Session Pooler.
# DATABASE_URL=jdbc:postgresql://aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres.hcsrkmlqekuhouenbusg
# DATABASE_PASSWORD=<supabase-db-password>
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=4    # pooler caps at 15 conns/project (shared with staging)
DATABASE_URL=jdbc:h2:mem:orders;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Auth / wallet integration (see bidmart-infrastructure/docs/DEPLOYMENT_URLS.md)
BIDMART_AUTH_BASE_URL=http://localhost:8080
# Staging Heroku: BIDMART_AUTH_BASE_URL=https://bidmart-auth-staging-392ed0eda7b8.herokuapp.com
# Production Heroku: BIDMART_AUTH_BASE_URL=https://bidmart-auth-876b62d83c69.herokuapp.com
BIDMART_AUTH_INTERNAL_SERVICE_TOKEN=bidmart-local-internal-token
GATEWAY_INTERNAL_TOKEN=bidmart-local-internal-token
AUTH_JWT_SECRET=bidmart-auth-secret-key-bidmart-auth-secret-key
WALLET_SERVICE_URL=http://localhost:8083
# Public HTTPS on the VPS edge is on port 8443 (SSH currently occupies 443).
# Staging: WALLET_SERVICE_URL=https://bidmart-staging.43.157.208.68.sslip.io:8443/api/v1/wallet
# Production: WALLET_SERVICE_URL=https://bidmart-prod.43.157.208.68.sslip.io:8443/api/v1/wallet
ORDER_AUTH_EVENTS_QUEUE=order-notification.auth-events
AUTH_AUDIT_EXCHANGE=bidmart.auth.events

# Swagger UI (docker-compose)
SWAGGER_UI_PORT=8088
